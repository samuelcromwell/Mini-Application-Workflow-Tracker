# Local development only. On Render, set these in the service Environment tab.

SECRET_KEY=change-me-in-production
DEBUG=true

# Optional — Render sets RENDER_EXTERNAL_HOSTNAME automatically
# ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL on Render (auto-injected when using render.yaml database)
# DATABASE_URL=postgres://...

# After deploying frontend on Vercel (comma-separated, no trailing slash):
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app
